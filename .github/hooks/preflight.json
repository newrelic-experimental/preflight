{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "bash": "command -v preflight-collector >/dev/null 2>&1 && preflight-collector pre-tool || exit 0",
        "powershell": "cmd /d /c \"where preflight-collector >nul 2>nul && preflight-collector pre-tool & exit 0\"",
        "timeoutSec": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "bash": "command -v preflight-collector >/dev/null 2>&1 && preflight-collector post-tool || exit 0",
        "powershell": "cmd /d /c \"where preflight-collector >nul 2>nul && preflight-collector post-tool & exit 0\"",
        "timeoutSec": 5
      }
    ]
  }
}

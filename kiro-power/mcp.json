{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "preflight": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@newrelic/preflight@1.74.0", "--stdio"],
      "env": {
        "NR_AI_MODE": "${NR_AI_MODE}",
        "NEW_RELIC_AI_PLATFORM": "${NEW_RELIC_AI_PLATFORM}"
      }
    }
  }
}

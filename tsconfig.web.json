{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  // Covers src/web source and tests. Tests need the `types` above to resolve Vitest
  // globals and jest-dom matchers, and this is the only project that claims them, so
  // narrowing it would leave them with no typechecker at all — including in the editor.
  // `npm run build` uses tsconfig.web.build.json, which excludes them from that gate.
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx"]
}

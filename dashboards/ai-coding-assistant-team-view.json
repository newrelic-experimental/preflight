{
  "name": "AI Coding Assistant \u2014 Team View",
  "description": "Team-level dashboard for AI coding assistant observability. Shows cost rollups, efficiency scores by developer, trend lines, and optimization insights across sessions. Requires AiToolCall, AiCodingTask, AiAntiPattern custom events and ai.* metrics.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "AI Coding Assistant \u2014 Team View",
      "description": "Team summary, developer comparison, trends, and optimization insights",
      "widgets": [
        {
          "title": "Total Team AI Spend (7d)",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 2,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(estimated_cost_usd) AS 'USD' SINCE 7 DAYS AGO"
              }
            ]
          }
        },
        {
          "title": "Average Efficiency Score (7d)",
          "layout": {
            "column": 3,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM Metric SELECT average(ai.efficiency.score) AS 'Score' SINCE 7 DAYS AGO"
              }
            ],
            "thresholds": [
              {
                "alertSeverity": "WARNING",
                "value": 0.5
              },
              {
                "alertSeverity": "CRITICAL",
                "value": 0.3
              }
            ]
          }
        },
        {
          "title": "Total Tasks Completed (7d)",
          "layout": {
            "column": 6,
            "row": 1,
            "width": 2,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT count(*) AS 'Tasks' FROM AiCodingTask WHERE developer = {{developer}} AND session_id = {{session_id}} SINCE 7 days ago"
              }
            ]
          }
        },
        {
          "title": "Average Cost per Task (7d)",
          "layout": {
            "column": 8,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT average(estimated_cost_usd) AS 'USD / Task' FROM AiCodingTask WHERE developer = {{developer}} AND session_id = {{session_id}} SINCE 7 days ago"
              }
            ]
          }
        },
        {
          "title": "Task Success Rate (7d)",
          "layout": {
            "column": 11,
            "row": 1,
            "width": 2,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT percentage(count(*), WHERE tests_passed > 0) AS 'Success %' FROM AiCodingTask WHERE developer = {{developer}} AND session_id = {{session_id}} SINCE 7 days ago"
              }
            ],
            "thresholds": [
              {
                "alertSeverity": "WARNING",
                "value": 70
              },
              {
                "alertSeverity": "CRITICAL",
                "value": 50
              }
            ]
          }
        },
        {
          "title": "Efficiency Score by Developer",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM Metric SELECT average(ai.efficiency.score) AS 'Score' FACET developer SINCE 7 DAYS AGO"
              }
            ]
          }
        },
        {
          "title": "Cost per Developer",
          "layout": {
            "column": 5,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(estimated_cost_usd) FACET developer SINCE 7 DAYS AGO"
              }
            ]
          }
        },
        {
          "title": "Tasks Completed per Developer",
          "layout": {
            "column": 9,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT count(*) FROM AiCodingTask WHERE developer = {{developer}} AND session_id = {{session_id}} FACET developer SINCE 7 days ago"
              }
            ]
          }
        },
        {
          "title": "Efficiency Score Trend (30d)",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM Metric SELECT average(ai.efficiency.score) FACET developer SINCE 30 DAYS AGO TIMESERIES 1 DAY"
              }
            ]
          }
        },
        {
          "title": "Cost Trend (30d)",
          "layout": {
            "column": 5,
            "row": 7,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(estimated_cost_usd) SINCE 30 DAYS AGO TIMESERIES 1 DAY"
              }
            ]
          }
        },
        {
          "title": "Anti-Pattern Frequency (30d)",
          "layout": {
            "column": 9,
            "row": 7,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT count(*) FROM AiAntiPattern WHERE developer = {{developer}} AND session_id = {{session_id}} FACET type TIMESERIES 1 day SINCE 30 days ago"
              }
            ]
          }
        },
        {
          "title": "Top 10 Most Expensive Tasks",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT max(estimated_cost_usd) FROM AiCodingTask WHERE developer = {{developer}} AND session_id = {{session_id}} FACET task_id SINCE 7 days ago LIMIT 10"
              }
            ]
          }
        },
        {
          "title": "Most Common Anti-Patterns",
          "layout": {
            "column": 5,
            "row": 10,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT count(*) FROM AiAntiPattern WHERE developer = {{developer}} AND session_id = {{session_id}} FACET type SINCE 7 days ago"
              }
            ]
          }
        },
        {
          "title": "Tool Call Patterns by Developer",
          "layout": {
            "column": 9,
            "row": 10,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT count(*) FROM AiToolCall WHERE developer = {{developer}} AND session_id = {{session_id}} FACET tool, developer SINCE 7 days ago"
              }
            ]
          }
        },
        {
          "title": "Skill Calls (7d)",
          "layout": {
            "column": 1,
            "row": 13,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT count(*) FROM AiToolCall WHERE tool = 'Skill' AND developer = {{developer}} AND session_id = {{session_id}} FACET skillName SINCE 7 DAYS AGO LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "Time in Skills (7d, hours)",
          "layout": {
            "column": 7,
            "row": 13,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT sum(duration_ms) / 3600000 AS 'Hours' FROM AiToolCall WHERE tool = 'Skill' AND developer = {{developer}} AND session_id = {{session_id}} FACET skillName SINCE 7 DAYS AGO LIMIT 20"
              }
            ]
          }
        }
      ]
    }
  ],
  "variables": [
    {
      "name": "developer",
      "title": "Developer",
      "type": "NRQL",
      "nrqlQuery": {
        "query": "SELECT uniques(developer) FROM AiToolCall SINCE 7 days ago",
        "accountIds": [0]
      },
      "isMultiSelection": false,
      "defaultValues": [],
      "replacementStrategy": "STRING",
      "options": {
        "excluded": true
      }
    },
    {
      "name": "session_id",
      "title": "Session ID",
      "type": "NRQL",
      "nrqlQuery": {
        "query": "SELECT uniques(session_id) FROM AiToolCall SINCE 7 days ago LIMIT 100",
        "accountIds": []
      },
      "isMultiSelection": false,
      "defaultValues": [],
      "replacementStrategy": "STRING",
      "options": {
        "excluded": true
      }
    }
  ]
}
